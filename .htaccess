Options -Indexes -MultiViews
DirectoryIndex index.php admin.php

# Block public web access to secrets, SQL dumps, logs, and markdown docs
<FilesMatch "(?i)^(\.env(\..*)?|\.git.*|\.cpanel\.yml|.*\.sql|.*\.p8|.*\.key|error_log|agents\.md|README\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to .git, .agents, .github, or sql directories via URL
    RewriteRule ^(?:sql|\.git|\.agents|\.github)/ - [F,L]

    # Enforce HTTPS only on the live production domain (leave localhost on HTTP)
    RewriteCond %{HTTP_HOST} ^(?:www\.)?fs-karavanke\.si$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://www.fs-karavanke.si/$1 [L,R=301]

    # Redirect legacy clanek.php?id=<ID> or clanek?id=<ID> to clean clanki/<ID>
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+((?:.*/)?)clanek(?:\.php)?\?(?:[^&\s]*&)*id=([0-9]+)(?:[&\s]|$) [NC]
    RewriteRule ^clanek(?:\.php)?$ /%1clanki/%2 [R=301,L,NE,QSD]

    # Redirect /index.php or /index in browser to clean directory root /
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+((?:.*/)?)index(?:\.php)?(?:[\s?]) [NC]
    RewriteRule ^(?:.+/)?index(?:\.php)?$ /%1 [R=301,L,NE]

    # Remove .php extension in browser URLs (excluding internal POST endpoints in admin/includes/)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{REQUEST_URI} !/admin/includes/ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
    RewriteRule ^(.+)\.php$ /%1 [R=301,L,NE]

    # Strip trailing slash from non-directory extensionless URLs
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+(?:[\s?]) [NC]
    RewriteRule ^(.+?)/+$ /%1 [R=301,L,NE]

    # Internally route extensionless URLs to matching .php files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

<IfModule php_module>
    php_value max_file_uploads 30
    php_value upload_max_filesize 15M
</IfModule>
