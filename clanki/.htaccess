Options -Indexes -MultiViews
DirectorySlash Off

# Disable PHP and script execution inside clanki/ media folders
<FilesMatch "\.(?:php|phtml|phar|php[0-9]|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

<IfModule php_module>
    php_flag engine off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Strip trailing slash on /clanki/<ID>/ so relative paths always resolve from /clanki/<ID>
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+((?:.*/)?clanki/[0-9]+)/+(?:[\s?]) [NC]
    RewriteRule ^[0-9]+/+$ /%1 [R=301,L,NE]

    # Route clean /clanki/<ID> URLs to the dynamic article controller
    RewriteRule ^([0-9]+)$ ../clanek.php?id=$1 [L,QSA]
</IfModule>
